# ==============================================================================
# Vigilux Monorepo - Git Ignore Configuration
# ==============================================================================

# --- Environment Variables & Sensitive Credentials (CRITICAL) ---
# Never commit raw credentials, Neon PostgreSQL secrets, or API tokens!
.env
.env.*
!.env.example
apps/*/.env
apps/*/.env.*
!apps/*/.env.example
packages/*/.env
packages/*/.env.*
!packages/*/.env.example

# --- Dependencies & Package Managers ---
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Python & ML Virtual Environments ---
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# --- Build Outputs & Bundles ---
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo

# --- Logs & Run-time Files ---
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# --- IDE & Editor Settings ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Operating System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
