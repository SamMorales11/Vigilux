# ==============================================================================
# VIGILUX SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================

# Fastify Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Neon Serverless PostgreSQL Connection String
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sweet-resonance-123456.us-east-2.aws.neon.tech/vigilux?sslmode=require
DATABASE_MAX_CONNECTIONS=10

# Security & CORS
CORS_ORIGIN=http://localhost:5173

# Telemetry Micro-Batching & Anomaly Settings
BATCH_SIZE=15
BATCH_INTERVAL_MS=10000
ANOMALY_THRESHOLD=0.80
WARNING_THRESHOLD=0.65
COOLDOWN_PERIOD_MS=60000
ELECTRICITY_COST_PER_KWH=0.15
