# ==============================================================================
# VIGILUX ML ENGINE ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend Ingestion Endpoint
BACKEND_API_URL=http://localhost:3000/api/v1/telemetry
BACKEND_DEMO_STATUS_URL=http://localhost:3000/api/v1/demo/status
REQUEST_TIMEOUT_SECONDS=3.0
MAX_RETRIES=3

# Industrial Telemetry Generator
SAMPLING_INTERVAL_SECONDS=1.0

# Degradation & Failure Scenario Simulation
SIMULATE_FAILURE=true
FAILURE_TARGET_ASSET=MOTOR-03
FAILURE_PROGRESSION_STEPS=60

# Model Artifacts Directory
ARTIFACTS_DIR=artifacts

# Logging
LOG_LEVEL=INFO
