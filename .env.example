# ==============================================================================
# VIGILUX MONOREPO - ROOT ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env in local environments:
#   cp .env.example .env
#
# IMPORTANT: Never commit actual passwords or connection strings to Git!

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Neon Serverless PostgreSQL)
# ------------------------------------------------------------------------------
# Example Neon Connection String:
# postgresql://[user]:[password]@[endpoint].neon.tech/[database]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sweet-resonance-123456.us-east-2.aws.neon.tech/vigilux?sslmode=require
DATABASE_MAX_CONNECTIONS=10

# ------------------------------------------------------------------------------
# 2. SERVER (Fastify Backend / apps/server)
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. PYTHON ML ENGINE (apps/ml-engine)
# ------------------------------------------------------------------------------
BACKEND_API_URL=http://localhost:3000/api/v1/telemetry
SIMULATE_FAILURE=true
FAILURE_TARGET_ASSET=MOTOR-03
FAILURE_PROGRESSION_STEPS=60
SAMPLING_INTERVAL_SECONDS=1.0

# ------------------------------------------------------------------------------
# 4. WEB DASHBOARD (Vue 3 + Vite / apps/web)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws/telemetry/live
